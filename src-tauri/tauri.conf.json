{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "vnasweep",
  "version": "0.1.0",
  "identifier": "com.zpeters.vnasweep",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "vnasweep",
        "width": 640,
        "height": 520,
        "minWidth": 480,
        "minHeight": 360
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
